{
  "version": 2,
  "buildCommand": "npm run build --prefix app/client",
  "outputDirectory": "app/client/dist",
  "installCommand": "npm install --prefix app/client",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}